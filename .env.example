# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
DATABASE_URL=postgresql://...            # Neon connection string
SESSION_SECRET=                          # run: openssl rand -hex 32
APP_URL=https://your-app.vercel.app      # used in invite links
ADMIN_EMAIL=you@example.com              # first administrator login
ADMIN_PASSWORD=                          # at least 12 characters; change after first login by editing the row, or remove this variable afterwards
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=you@gmail.com               # the Gmail account that authorised the token
GMAIL_SENDER_NAME=Task List

# WhatsApp message (task + photo) when a task is completed (Meta WhatsApp Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_RECIPIENTS=233201234567,233241234567
WHATSAPP_TEMPLATE=task_completed
WHATSAPP_TEMPLATE_LANG=en

# Optional: Telegram message (task + photo) when a task is completed (task + photo) when a task is completed
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=123456789,-1001234567890
APP_TIMEZONE=UTC
